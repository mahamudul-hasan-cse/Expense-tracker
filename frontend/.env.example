# Copy to .env.local for development. Never commit the real file.

# Where the Next.js server proxies /api/* (see next.config.mjs). The browser
# never calls this URL directly, so auth cookies stay first-party.
# Read at BUILD time: rebuild the frontend after changing it.
BACKEND_URL=http://localhost:8000

# Optional, normally leave unset. Makes the browser call the backend directly
# instead of through the proxy. Only use it if frontend and backend share a
# site; otherwise the refresh cookie is third-party and gets blocked.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1


# Same value as PROXY_SHARED_SECRET on the backend (runtime, server-side only).
# Only set it where the platform overwrites X-Real-IP with the real client IP (Vercel does).
# PROXY_SHARED_SECRET=

# Error monitoring (Sentry, optional; see docs/MONITORING.md). Empty = off.
# NEXT_PUBLIC_ is read at BUILD time (browser errors); SENTRY_DSN at runtime (server).
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_DSN=