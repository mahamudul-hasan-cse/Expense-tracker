# Copy to .env.local for development. Never commit the real file.

# Where the Next.js server proxies /api/* (see next.config.mjs). The browser
# never calls this URL directly, so auth cookies stay first-party.
# Read at BUILD time: rebuild the frontend after changing it.
BACKEND_URL=http://localhost:8000

# Optional, normally leave unset. Makes the browser call the backend directly
# instead of through the proxy. Only use it if frontend and backend share a
# site; otherwise the refresh cookie is third-party and gets blocked.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
