# Copy to .env and fill in. Never commit the real .env.

# development | test | production. Production refuses to start with the dev SECRET_KEY.
APP_ENV=development

# Postgres connection string
DATABASE_URL=postgresql://wallet_user:wallet_pass@localhost:5432/wallet_agent

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Signs auth tokens. Required in production (32+ chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh-token cookie flags. If the frontend and API are on different sites
# (e.g. app.vercel.app and api.onrender.com), use COOKIE_SECURE=true and
# COOKIE_SAMESITE=none. On localhost the defaults (false / lax) work.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Only read once, by the add_users_and_ownership migration, when existing data
# is assigned to a first "owner" account. If OWNER_PASSWORD is empty the owner
# can't log in until you run: uv run python -m app.cli set-password <email>
OWNER_EMAIL=owner@localhost
OWNER_PASSWORD=
