# Copy to .env and fill in. Never commit the real .env.

# development | test | production. Production refuses to start unless
# SECRET_KEY, DATABASE_URL and ALLOWED_ORIGINS are set properly, and it logs JSON.
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Postgres connection string
DATABASE_URL=postgresql://wallet_user:wallet_pass@localhost:5432/wallet_agent

# Comma-separated frontend origin(s) allowed to call the API from a browser.
# Never "*". (The older name CORS_ORIGINS is still accepted.)
ALLOWED_ORIGINS=http://localhost:3000

# Signs auth tokens. Required in production (32+ chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh-token cookie flags. The cookie is always HttpOnly and scoped to
# Path=/api/v1/auth. The frontend proxies /api/* to this backend (see
# frontend/next.config.mjs), so the cookie is first-party and these defaults
# are right for production too:
#   COOKIE_SECURE: unset = true when APP_ENV=production, false otherwise
#                  (plain-http localhost). Production refuses false.
#   COOKIE_SAMESITE: strict (default). Only use "none" (with COOKIE_SECURE=true)
#                  if the browser calls the API cross-site without the proxy.
# COOKIE_SECURE=
COOKIE_SAMESITE=strict

# Only read once, by the add_users_and_ownership migration, when existing data
# is assigned to a first "owner" account. Recommended: set only OWNER_EMAIL,
# then set the password interactively (it never touches a file or shell history):
#   uv run python -m app.cli set-password <email>
# OWNER_PASSWORD is supported but leave it empty.
OWNER_EMAIL=owner@localhost
OWNER_PASSWORD=

# Rate limits per client IP (slowapi syntax). Behind a proxy, run uvicorn with
# --proxy-headers and FORWARDED_ALLOW_IPS=<proxy IP> so the real client IP is used.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=5/minute;20/hour
# Failed logins per account (email), whatever the IP
RATE_LIMIT_LOGIN_FAILURES=10/hour
# memory:// is per process. With several workers/instances use a shared store, e.g. redis://host:6379
RATE_LIMIT_STORAGE_URI=memory://

# --- AI assistant (OpenRouter) ---------------------------------------------
# Backend only. Never commit the real key, never expose it to the frontend.
# The assistant is disabled (the app still runs) when this is empty.
# Give the key a credit limit in the OpenRouter dashboard.
OPENROUTER_API_KEY=
# Main model slug (must support tools + streaming). Leave unset to use the
# documented default; the production model is picked from the eval results.
ASSISTANT_MODEL=
# Optional comma-separated fallbacks, tried in order if the main model fails
ASSISTANT_FALLBACK_MODELS=
# Sent to OpenRouter as attribution headers (HTTP-Referer / X-Title)
ASSISTANT_APP_URL=http://localhost:3000
ASSISTANT_APP_NAME=Wallet Agent
